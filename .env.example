# Copy this file to .env and fill in the keys for your deployment mode
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://api.ollama.cloud
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
MODAL_ENDPOINT_URL=

# ── Hybrid mode (DEPLOYMENT_MODE=hybrid) ──────────────────────────────
# Small worker model runs locally via Ollama; compiler runs on Modal.
#   LOCAL_WORKER_URL=http://localhost:11434/v1
#   LOCAL_WORKER_MODEL=smollm2:135m-instruct
#
DEPLOYMENT_MODE=modal
LOCAL_WORKER_URL=http://localhost:11434/v1
LOCAL_WORKER_MODEL=smollm2:135m-instruct
LOCAL_WORKER_API_KEY=none
